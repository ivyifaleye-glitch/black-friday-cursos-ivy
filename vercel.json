{
  "rewrites": [
    {
      "source": "/blackalunos",
      "destination": "/index.html"
    },
    {
      "source": "/blackfriday",
      "destination": "/portas-de-entrada.html"
    },
    {
      "source": "/blackalunos.afi",
      "destination": "/blackalunos-afiliados.html"
    },
    {
      "source": "/blackfriday.afi",
      "destination": "https://blackfriday-portas-afiliada.vercel.app/"
    },
    {
      "source": "/erveira",
      "destination": "/erveira/index.html"
    },
    {
      "source": "/erveira/obrigado",
      "destination": "/erveira/obrigado.html"
    }
  ],
  "headers": [
    {
      "source": "/erveira/obrigado",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
